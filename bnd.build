- tgt: ipmcult
  cmd: emu --snapshot ./data/div-ipm.sna --crtc 1 run

- tgt: birthro
  cmd: bndbuild -f src test

- tgt: dist
  phony: true
  cmd:
    - -rm  dist
    - bndbuild -f src DAD-MODE.DSK
    - mkdir -p dist/albi
    - cp src/DAD-MODE.DSK dist
    - cp src/loading/DAD-MODE.BAS dist/albi 
    - cp src/loading/DAD-MODE.003 dist/albi 
    - cp src/loading/CATART.ASC dist/albi 
    - cp src/DAD-MODE.000 dist/albi
    - cp src/DAD-MODE.001 dist/albi

- tgt: clean
  phony: true
  cmd:
    - bndbuild -f src clean
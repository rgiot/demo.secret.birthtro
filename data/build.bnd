

# Duplicate and adapt in case of change of picture
# Voxy stick to your configration, do not change extension and/or resolution each time otherwise it will not work as expected
- tgt: face3_cpc.scr face3_cpc.pal
  dep: Baby_Face_v3.bmp
  cmd: 
    - img2cpc --mode 0 --overscan  Baby_Face_v3.bmp scr  --output face3_cpc.scr --palette face3_cpc.pal



- tgt: face4_cpc.scr face4_cpc.pal
  dep: Baby_Face_v4.png
  cmd: 
    - img2cpc --mode 0 --overscan  Baby_Face_v4.png scr  --output face4_cpc.scr --palette face4_cpc.pal



- tgt: face5_cpc.scr face5_cpc.pal
  dep: Baby_Face_v5.png
  cmd: 
    - img2cpc --mode 0 --overscan  Baby_Face_v5.png scr  --output face5_cpc.scr --palette face5_cpc.pal

- tgt: face6_cpc.scr face6_cpc.pal
  dep: Baby_Face_v6.png
  cmd: 
    - img2cpc --mode 0 --overscan  Baby_Face_v6.png scr  --output face6_cpc.scr --palette face6_cpc.pal


# Temporary build while there is no eyes drawned
- tgt: face3_eye0.spr face3_eye1.spr face3_eye2.spr
  dep: face3_eye0.png face3_eye1.png face3_eye2.png face3_cpc.pal
  cmd:
    - img2cpc --mode 0 --ga-pal face3_cpc.pal face3_eye0.png sprite --output face3_eye0.spr
    - img2cpc --mode 0 --ga-pal face3_cpc.pal face3_eye1.png sprite --output face3_eye1.spr
    - img2cpc --mode 0 --ga-pal face3_cpc.pal face3_eye2.png sprite --output face3_eye2.spr



- tgt: face4_eye0.spr face4_eye1.spr face4_eye2.spr
  dep: face3_eye0.spr face3_eye1.spr face3_eye2.spr
  cmd: 
    - cp face3_eye0.spr face4_eye0.spr
    - cp face3_eye1.spr face4_eye1.spr
    - cp face3_eye2.spr face4_eye2.spr

- tgt: face5_eye0.spr face5_eye1.spr face5_eye2.spr
  dep: face3_eye0.spr face3_eye1.spr face3_eye2.spr
  cmd: 
    - cp face3_eye0.spr face5_eye0.spr
    - cp face3_eye1.spr face5_eye1.spr
    - cp face3_eye2.spr face5_eye2.spr

- tgt: face6_eye0.spr face6_eye1.spr face6_eye2.spr
  dep: face6_eye0.png face6_eye1.png face6_eye2.png face6_cpc.pal 
  cmd: 
    - img2cpc --mode 0 --ga-pal face6_cpc.pal face6_eye0.png sprite --output face6_eye0.spr
    - img2cpc --mode 0 --ga-pal face6_cpc.pal face6_eye1.png sprite --output face6_eye1.spr
    - img2cpc --mode 0 --ga-pal face6_cpc.pal face6_eye2.png sprite --output face6_eye2.spr




- tgt: face6_right_eye0.spr face6_right_eye1.spr face6_right_eye2.spr
  dep: face6_right_eye0.png face6_right_eye1.png face6_right_eye2.png face6_cpc.pal 
  cmd: 
    - img2cpc --mode 0 --ga-pal face6_cpc.pal face6_right_eye0.png sprite --output face6_right_eye0.spr
    - img2cpc --mode 0 --ga-pal face6_cpc.pal face6_right_eye1.png sprite --output face6_right_eye1.spr
    - img2cpc --mode 0 --ga-pal face6_cpc.pal face6_right_eye2.png sprite --output face6_right_eye2.spr



# loader
- dep : loader/loading.png
  tgt : loading.scr loading.pal loading.inks loading.fadepal
  cmd:
    - img2cpc --mode 0 --pen15 8 --pen14 10 --pen13 12 --pen12 17 --pen11 20  --pen10 14 --unlock-pens loader/loading.png scr --output loading.scr --palette loading.pal --inks loading.inks --palette_fadeout loading.fadepal

- dep: loader/SPRITES_VAPEUR_28x92.png loading.pal
  tgt: VAPEUR_000.SPR VAPEUR_001.SPR VAPEUR_002.SPR VAPEUR_003.SPR VAPEUR_004.SPR VAPEUR_005.SPR VAPEUR_006.SPR VAPEUR_007.SPR VAPEUR_008.SPR
  cmd: img2cpc --ga-pal loading.pal loader/SPRITES_VAPEUR_28x92.png tile --width 14 --height 92 --output VAPEUR.SPR


- dep: intro/logo.png
  tgt: logo.scr logo.pal logo.inks logo.fadepal
  cmd:
    - img2cpc --mode 0 --skipoddpixels  --overscan intro/logo.png scr --output logo.scr --palette logo.pal --inks logo.inks --palette_fadeout logo.fadepal


- tgt: clean
  phony: true
  cmd:
    - -rm face?_cpc.scr face?_cpc.pal 
    - -rm face?_eye0.spr face?_eye1.spr face?_eye2.spr
    - -rm face?_right_eye0.spr face?_right_eye1.spr face?_right_eye2.spr
    - -rm eye0.spr eye1.spr eye2.spr
    - -rm loading.scr loading.pal loading.inks
    - -rm logo.scr logo.pal logo.inks logo.fadepal
    - -rm VAPEUR_000.SPR VAPEUR_001.SPR VAPEUR_002.SPR VAPEUR_003.SPR VAPEUR_004.SPR VAPEUR_005.SPR VAPEUR_006.SPR VAPEUR_007.SPR VAPEUR_008.SPR



{% set LOADER_CODE_ADDRESS = 0x2000 %}
{% set LOADER_LINKER_ADDRESS = 0x2B0 %}


- tgt: test
  dep: PATER.DSK
  phony: true
  cmd: -ace   PATER.DSK

- tgt: PATER.DSK
  dep: PATER.BAS
  cmd:
    - dsk PATER.DSK format
    - dsk PATER.DSK add PATER.BAS

- tgt: PATER.BAS
  dep: paternity.asm LOADER.BIN build.bnd
  cmd: basm paternity.asm --basic -o PATER.BAS -DLOADER_LINKER_ADDRESS={{ LOADER_LINKER_ADDRESS }}



- tgt: DAD-MODE.DSK
  dep: DAD-MODE.BAS DAD-MODE.003 CATART.ASC
  cmd:
    - catalog CATART.ASC build --output DAD-MODE.DSK
    - impdsk -dsk DAD-MODE.DSK -put DAD-MODE.BAS -hide
    - impdsk -dsk DAD-MODE.DSK -put DAD-MODE.003 -hide

- tgt: DAD-MODE.BAS
  dep: dad-mode.asm LOADER.BIN build.bnd
  cmd: basm dad-mode.asm --basic -o DAD-MODE.BAS -DLOADER_LINKER_ADDRESS={{ LOADER_LINKER_ADDRESS }} 

- tgt: test_loading_linker
  dep: loading_linker.sna
  phony: true
  cmd: ace loading_linker.sna 

- tgt: loading_linker.sna LOADER.BIN DAD-MODE.003
  dep: C0.C000 C0.2000 loading_linker.asm build.bnd ../logo/C0.4000 ../logo/C0.C000
  cmd: basm loading_linker.asm --snapshot -o loading_linker.sna -DLOADER_LINKER_ADDRESS={{ LOADER_LINKER_ADDRESS }} -DLOADER_CODE_ADDRESS={{ LOADER_CODE_ADDRESS }}


- tgt: ../logo/C0.4000 ../logo/C0.C000
  cmd: bndbuild -f ../logo  C0.C000

- tgt: test_loading
  dep: loading.sna
  phony: true
  cmd: -emu --emulator ace   --snapshot loading.sna run

- tgt: loading.sna C0.2000 C0.C000
  dep: loading.asm sid_player.asm ../../data/loading.pal loading_animate.asm ../animate_lib.asm ../../data/VAPEUR_000.SPR ../../data/VAPEUR_001.SPR ../../data/VAPEUR_002.SPR ../../data/VAPEUR_003.SPR ../../data/VAPEUR_004.SPR ../../data/VAPEUR_005.SPR ../../data/VAPEUR_006.SPR ../../data/VAPEUR_007.SPR ../../data/VAPEUR_008.SPR ../../data/music/loading/birthtro_sid.asm
  cmd: basm loading.asm --snapshot -o loading.sna -DLOADER_CODE_ADDRESS={{ LOADER_CODE_ADDRESS }} -DLOADER_LINKER_ADDRESS={{ LOADER_LINKER_ADDRESS }}

- tgt: linked_loading.sna
  dep: C0.2000 C0.C000
  cmd: basm linked_loading.asm --snapshot -o linked_loading.sna

- tgt: ../../data/loading.pal
  phony: true
  cmd: bndbuild -f ../../data loading.pal

- tgt: ../../data/VAPEUR_000.SPR ../../data/VAPEUR_001.SPR ../../data/VAPEUR_002.SPR ../../data/VAPEUR_003.SPR ../../data/VAPEUR_004.SPR ../../data/VAPEUR_005.SPR ../../data/VAPEUR_006.SPR ../../data/VAPEUR_007.SPR ../../data/VAPEUR_008.SPR
  phony: true
  cmd: bndbuild -f ../../data VAPEUR_000.SPR


- tgt: clean
  phony: true
  cmd:
    - -rm  *.{sna,bin,lst,html}
    - -rm DAD-MODE.*
    - -rm C0.2000 C0.4000 C0.C000
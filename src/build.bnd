
{% set SNA="birthtro.sna" %}
{% set DSK="PATER.DSK" %}
{% set EXE="PATER.000" %}

# Variables to be set by the user. They control the image used as well as its dimensions
# Wrong values imply wrong results, so be careful when changing them
{% set FACE="face6" %} # Change here the prefix of the background if needed to change the picture

# of course, each sprite share the same parameter...
{%set SPRITE0_WIDTH=54//2 %} # Number of bytes  in the width of the sprite (we obtain the number of pixels by multiplying it by 4)
{%set SPRITE0_HEIGHT=50 %} # Number of lines of the sprite
{%set SPRITE0_X_OFFSET=4 %} # horizontal position in byte (so *2 to get the number of pixels) from left of the screen
{%set SPRITE0_Y_OFFSET=28-9 %} # vertical position in pixel from top of the screen

{%set SPRITE1_WIDTH=52//2 %} # Number of bytes  in the width of the sprite (we obtain the number of pixels by multiplying it by 4)
{%set SPRITE1_HEIGHT=55 %} # Number of lines of the sprite (52x55 pixels pictures)
{%set SPRITE1_X_OFFSET=61 %} # horizontal position in byte (so *2 to get the number of pixels) from left of the screen
{%set SPRITE1_Y_OFFSET=10 %} # vertical position in pixel from top of the screen


# Automatially created variables
{% set FACE_SCR="../data/" ~ FACE ~ "_cpc.scr" %}
{% set FACE_PAL="../data/" ~ FACE ~ "_cpc.pal" %}

{% set LEFT_EYE0_SPR="../data/" ~ FACE ~ "_eye0.spr" %}
{% set LEFT_EYE1_SPR="../data/" ~ FACE ~ "_eye1.spr" %}
{% set LEFT_EYE2_SPR="../data/" ~ FACE ~ "_eye2.spr" %}

{% set RIGHT_EYE0_SPR="../data/" ~ FACE ~ "_right_eye0.spr" %}
{% set RIGHT_EYE1_SPR="../data/" ~ FACE ~ "_right_eye1.spr" %}
{% set RIGHT_EYE2_SPR="../data/" ~ FACE ~ "_right_eye2.spr" %}


{% set MUSIC_DATA="../data/music/birhtro.asm" %}
{% set MUSIC_CFG="../data/music/birhtro_playerconfig.asm" %}

{%set SNA_GENERATED=["C0.300", "C0.8000", "C5.4000", "C6.4000", "C7.4000"]%}

- tgt: test_sna
  dep: {{ SNA }}
  cmd: -emu --emulator ace   --snapshot {{SNA}} run
- tgt: debug_sna
  dep: {{ SNA }}
  cmd: -emu --emulator ace   --snapshot {{SNA}} debug



- tgt: test_loading_sna
  dep: loading.sna
  cmd: -emu --emulator winape   --snapshot loading.sna run

- tgt: loading.sna
  dep: loading/loading.asm loading/sid_player.asm
  cmd: basm loading/loading.asm --snapshot -o loading.sna

- tgt: {{SNA}} {{SNA_GENERATED | join(" ")}} sna.lst  sna.map sna.sym
  dep:
    - "*.asm"
    - "demosystem/*.asm"
    - {{ FACE_SCR }}
    - {{ FACE_PAL }}
    - {{ LEFT_EYE0_SPR }} {{ LEFT_EYE1_SPR }} {{ LEFT_EYE2_SPR }}
    - {{ RIGHT_EYE0_SPR }} {{ RIGHT_EYE1_SPR }} {{ RIGHT_EYE2_SPR }}
    - {{ MUSIC_DATA }}
    - {{ MUSIC_CFG }}
    - split_scroller_text.txt
    - "writter_page*.txt"
    - build.bnd
  cmd: |
    basm --snapshot sna.asm 
        -o {{SNA}} 
        -DFACE_SCR=\"{{FACE_SCR}}\" -DFACE_PAL=\"{{FACE_PAL}}\"
        -DLEFT_EYE0_SPR=\"{{LEFT_EYE0_SPR}}\" -DLEFT_EYE1_SPR=\"{{LEFT_EYE1_SPR}}\" -DLEFT_EYE2_SPR=\"{{LEFT_EYE2_SPR}}\"
        -DRIGHT_EYE0_SPR=\"{{RIGHT_EYE0_SPR}}\" -DRIGHT_EYE1_SPR=\"{{RIGHT_EYE1_SPR}}\" -DRIGHT_EYE2_SPR=\"{{RIGHT_EYE2_SPR}}\"
        -DSPRITE0_WIDTH={{SPRITE0_WIDTH}} -DSPRITE0_HEIGHT={{SPRITE0_HEIGHT}}
        -DSPRITE0_X_OFFSET={{SPRITE0_X_OFFSET}} -DSPRITE0_Y_OFFSET={{SPRITE0_Y_OFFSET}}
        -DSPRITE1_WIDTH={{SPRITE1_WIDTH}} -DSPRITE1_HEIGHT={{SPRITE1_HEIGHT}}
        -DSPRITE1_X_OFFSET={{SPRITE1_X_OFFSET}} -DSPRITE1_Y_OFFSET={{SPRITE1_Y_OFFSET}}
        -DMUSIC_DATA=\"{{MUSIC_DATA}}\" -DMUSIC_CFG=\"{{MUSIC_CFG}}\"
        --lst sna.lst --sourcemap sna.map --sym sna.sym


- tgt: test_snalink
  dep: link.sna
  cmd: -emu --emulator ace --snapshot link.sna run


- tgt: test_dsk
  dep: {{DSK}}
  cmd: -emu --emulator ace --drivea {{DSK}} --auto-run-file=BIRTHTRO run

- tgt: clean
  phony: true
  cmd:
    - -rm {{SNA}} {{DSK}} {{SNA_GENERATED | join(" ")}} link.sna sna.map
    - bndbuild -f ../data clean
    - bndbuild -f loading clean


- tgt: {{ FACE_SCR }} {{EYE0_SPR}} {{EYE1_SPR}} {{EYE2_SPR}} {{RIGHT_EYE0_SPR}} {{RIGHT_EYE1_SPR}} {{RIGHT_EYE2_SPR}}
  phony: true
  cmd: 
   - bndbuild -f ../data {{FACE ~ "_cpc.pal"}}
   - bndbuild -f ../data {{FACE ~ "_eye0.spr"}}
   - bndbuild -f ../data {{FACE ~ "_right_eye0.spr"}}


- tgt: link.sna {{DSK}} 
  dep: {{SNA_GENERATED | join(" ")}} dsk.asm
  phony: true
  cmd:
     - bndbuild -f loading PATER.DSK
     - cp ./loading/PATER.DSK PATER.DSK

     - basm dsk.asm --override --snapshot -o link.sna